<mxCell id="n30" value="Empleado y Administrador pueden consultar y modificar reservas." style="html=1;whiteSpace=wrap;fontColor=#FFFFFF;strokeColor=#FFFFFF;fillColor=#000000;strokeWidth=2;fontFamily=Helvetica;fontSize=13;shape=note;size=14;backgroundOutline=1;darkOpacity=0;darkOpacity2=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="800.0" y="90.0" width="490.0" height="80.0" as="geometry"/></mxCell>
