<mxCell id="n40" value="RegistroOperacion es de solo inserción: no se edita ni se elimina. Guarda quién hizo cada cambio y los valores anterior y nuevo en detalle.&lt;br&gt;&lt;br&gt;Las preguntas frecuentes y la galería alimentan la página de inicio y las administra el Administrador." style="html=1;whiteSpace=wrap;fontColor=#FFFFFF;strokeColor=#FFFFFF;fillColor=#000000;strokeWidth=2;fontFamily=Helvetica;fontSize=12;shape=note;size=14;backgroundOutline=1;darkOpacity=0;darkOpacity2=0;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1010.0" y="740.0" width="440.0" height="170.0" as="geometry"/></mxCell>
